# Terraform Variables Example
# Copy this file to terraform.tfvars and update values for your environment

# AWS Configuration
aws_region = "us-east-1"
environment = "production"
app_name = "headband"

# VPC Configuration
vpc_cidr = "10.0.0.0/16"

# EKS Configuration
eks_cluster_version = "1.28"
node_desired_size = 3
node_min_size = 3
node_max_size = 10
node_instance_types = ["t3.medium", "t3.large"]
backend_replicas = 3
frontend_replicas = 3
worker_replicas = 2

# RDS Configuration
db_instance_class = "db.t3.medium"
db_allocated_storage = 100
db_backup_retention_days = 30
enable_multi_az = true
enable_performance_insights = true

# ElastiCache Configuration
redis_node_type = "cache.t3.medium"

# Container Configuration
container_port = 3000

# SSL/TLS Certificate (from AWS Certificate Manager)
certificate_arn = "arn:aws:acm:us-east-1:123456789012:certificate/12345678-1234-1234-1234-123456789012"

# Domain Names
domain_name = "headband.app"
api_domain = "api.headband.app"

# Feature Flags
enable_cloudfront = true
enable_waf = true
enable_backup = true

# Backup Configuration
backup_retention_days = 30

# Tags
tags = {
  Project     = "Headband"
  Environment = "production"
  ManagedBy   = "Terraform"
  Team        = "DevOps"
  CostCenter  = "Engineering"
}

# Development Environment Example (uncomment to use)
# aws_region = "us-east-1"
# environment = "development"
# app_name = "headband-dev"
# node_desired_size = 2
# node_min_size = 1
# node_max_size = 3
# db_instance_class = "db.t3.micro"
# redis_node_type = "cache.t3.micro"
# enable_multi_az = false
# enable_performance_insights = false
# enable_cloudfront = false
# enable_waf = false

# Staging Environment Example (uncomment to use)
# aws_region = "us-east-1"
# environment = "staging"
# app_name = "headband-staging"
# node_desired_size = 2
# node_min_size = 2
# node_max_size = 5
# db_instance_class = "db.t3.small"
# redis_node_type = "cache.t3.small"
# enable_multi_az = false
# enable_performance_insights = true
# enable_cloudfront = true
# enable_waf = true
