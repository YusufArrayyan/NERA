# ─── Database ─────────────────────────────
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nera_db?schema=public"

# ─── JWT ──────────────────────────────────
JWT_SECRET="neuro-adaptive-jwt-secret-key-2026-change-in-production"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="neuro-adaptive-refresh-secret-key-2026-change-in-production"
JWT_REFRESH_EXPIRES_IN="7d"

# ─── Redis ────────────────────────────────
REDIS_HOST="localhost"
REDIS_PORT=6379

# ─── App ──────────────────────────────────
PORT=3001
NODE_ENV="development"
CORS_ORIGIN="http://localhost:3000,https://nera-learning.vercel.app"

# ─── EEG Simulator ───────────────────────
EEG_PROVIDER="simulator"
SIMULATOR_SAMPLING_RATE=256
SIMULATOR_DEFAULT_PATTERN="MODERATE_FOCUS"

# ─── EmailJS ─────────────────────────────
EMAILJS_SERVICE_ID="service_neuro"
EMAILJS_TEMPLATE_ID="template_neuro"
EMAILJS_PUBLIC_KEY="your_emailjs_public_key"
