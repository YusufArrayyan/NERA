# Backend Production Environment Variables
# CRITICAL: Never commit actual .env.production to Git!
# Set these in your hosting platform (Render/Railway/AWS)

# ===== REQUIRED =====

# Node Environment
NODE_ENV=production

# Server Port (Render uses 10000, Railway auto-assigns)
PORT=10000

# Database Connection (PostgreSQL)
# Get this from your database provider (Render/Supabase)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://user:password@host:5432/nera_prod

# JWT Secrets (MUST BE UNIQUE, MIN 32 CHARACTERS)
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=your-production-secret-min-32-chars-long-CHANGE-THIS
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-min-32-chars-long-CHANGE-THIS
JWT_REFRESH_EXPIRES_IN=7d

# CORS Origins (comma-separated, NO SPACES, NO TRAILING SLASHES)
CORS_ORIGIN=https://nera-learning.vercel.app,https://your-custom-domain.com

# ===== OPTIONAL BUT RECOMMENDED =====

# Sentry Error Tracking
SENTRY_DSN=https://xxxxx@o1234567.ingest.sentry.io/1234567

# OpenAI API Key (for advanced AI features)
OPENAI_API_KEY=sk-proj-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Email Service (for notifications)
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SMTP_FROM=noreply@nera.app

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# File Upload (if using cloud storage)
AWS_S3_BUCKET=nera-uploads
AWS_ACCESS_KEY_ID=AKIAXXXXXXXXXX
AWS_SECRET_ACCESS_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
AWS_REGION=us-west-2

# Redis (for caching/sessions - optional)
REDIS_URL=redis://default:password@redis-host:6379

# ===== LOGGING =====

LOG_LEVEL=info
LOG_FILE_MAX_SIZE=20m
LOG_FILE_MAX_FILES=14d

# ===== SECURITY =====

# Bcrypt rounds (higher = more secure but slower)
BCRYPT_ROUNDS=12

# Session secret (for additional security)
SESSION_SECRET=another-unique-secret-min-32-chars

# ===== FEATURE FLAGS =====

# Enable/disable features
ENABLE_EMAIL_NOTIFICATIONS=true
ENABLE_REAL_EEG_DEVICE=false
ENABLE_AI_RECOMMENDATIONS=true
ENABLE_GAMIFICATION=true

# ===== ANALYTICS =====

# Google Analytics (backend tracking)
GA_TRACKING_ID=UA-XXXXXXXXX-X

# ===== WEBHOOKS =====

# Slack notifications
SLACK_WEBHOOK_URL=https://hooks.slack.com/services/YOUR_WORKSPACE_ID/YOUR_CHANNEL_ID/YOUR_SECRET_KEY

# Discord notifications (alternative)
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/YOUR_WEBHOOK_ID/YOUR_WEBHOOK_TOKEN
