# Application Environment
NODE_ENV=production

# Database Configuration
DB_USER=headband
DB_PASSWORD=changeMe123!
DB_NAME=headband_db
DB_PORT=5432

# Redis Configuration
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# Backend Configuration
BACKEND_PORT=3000
PORT=3000

# Frontend Configuration
FRONTEND_PORT=3001
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_WS_URL=ws://localhost:3000

# JWT Configuration
JWT_SECRET=your-secret-key-change-in-production-minimum-32-chars
JWT_EXPIRATION=3600

# Logging
LOG_LEVEL=info

# Email Configuration (optional)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_FROM=noreply@headband.app

# AWS Configuration (optional, for S3/deployment)
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=headband-bucket

# Analytics (optional)
MIXPANEL_TOKEN=your-mixpanel-token
SEGMENT_WRITE_KEY=your-segment-key

# Stripe Configuration (optional)
STRIPE_PUBLIC_KEY=pk_test_...
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Google OAuth (optional)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-client-secret

# Sentry Configuration (optional, for error tracking)
SENTRY_DSN=https://your-dsn@sentry.io/project-id

# Feature Flags
FEATURE_MULTIPLAYER=true
FEATURE_ADVANCED_ANALYTICS=true
FEATURE_PREMIUM_FEATURES=true

# Security
CORS_ORIGIN=http://localhost:3001,https://yourdomain.com
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
