# Copy this file to .env.development for local development
# Or .env.production for production deployment

# Application
NODE_ENV=development
APP_ENV=development
LOG_LEVEL=debug

# Database
DATABASE_URL=postgresql://headband:password@localhost:5432/headband_db
DB_HOST=localhost
DB_PORT=5432
DB_USER=headband
DB_PASSWORD=changeme
DB_NAME=headband_db

# Redis
REDIS_URL=redis://:password@localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=changeme

# JWT
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# CORS
CORS_ORIGINS=http://localhost:3001,http://localhost:3000

# Elasticsearch
ELASTICSEARCH_HOST=localhost
ELASTICSEARCH_PORT=9200
ELASTICSEARCH_USERNAME=elastic
ELASTICSEARCH_PASSWORD=elastic

# Logging
LOGSTASH_HOST=localhost
LOGSTASH_PORT=5000

# ML Model
ML_MODEL_PATH=./models/eeg-classifier.onnx
ML_MODEL_CACHE_SIZE=500

# Feature Flags
ENABLE_METRICS=true
ENABLE_SWAGGER=true
ENABLE_DEBUG_ENDPOINTS=true

# Worker
WORKER_CONCURRENCY=4
