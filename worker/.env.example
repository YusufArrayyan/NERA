# NERA Worker Environment Configuration

# Cloud Backend
API_URL=http://localhost:3001
WS_URL=ws://localhost:3001
API_KEY=your_api_token_here

# Session Configuration
USER_ID=demo-user
SESSION_ID=demo-session

# EEG Device Configuration
EEG_DEVICE_PORT=/dev/ttyUSB0  # Linux/Mac
# EEG_DEVICE_PORT=COM3  # Windows
EEG_BAUD_RATE=115200
EEG_SAMPLE_RATE=256

# Logging
LOG_LEVEL=info
LOG_FILE=nera-worker.log
