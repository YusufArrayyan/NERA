# Frontend Production Environment Variables
# Copy this to .env.production and fill in your values

# Backend API URL (your deployed backend)
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com

# WebSocket URL (same as API URL for most deployments)
NEXT_PUBLIC_WS_URL=https://your-backend.onrender.com

# Sentry Error Tracking (optional but recommended)
NEXT_PUBLIC_SENTRY_DSN=https://xxxxx@o1234567.ingest.sentry.io/7654321

# Google Analytics (optional)
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# Environment
NEXT_PUBLIC_ENV=production
